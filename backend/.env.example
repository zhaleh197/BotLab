# Copy to backend/.env for local development.

# --- LLM (any OpenAI-compatible provider) ---
# Google Gemini (free tier): key from https://aistudio.google.com/apikey
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash
LLM_API_KEY=

# Groq (free tier) alternative:
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# OpenRouter free models alternative:
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Database --- (empty = local SQLite file backend/data.db)
DATABASE_URL=

# --- Auth ---
JWT_SECRET=change-me

# --- Bots ---
# Public https URL of this server; bots use webhooks when set, long-polling when empty.
# On Render this is detected automatically (RENDER_EXTERNAL_URL).
PUBLIC_URL=

# Models tried when the main one is busy (503) or rate limited (429). For Groq/OpenRouter set your own list.
LLM_FALLBACK_MODELS=gemini-flash-latest,gemini-3.5-flash-lite
